{
  "name": "the-last-lie",
  "version": "0.1.0",
  "private": true,
  "description": "THE LAST LIE: Infinite — Monorepo scaffold",
  "type": "module",
  "scripts": {
    "lastlie": "node tools/cli/node_modules/tsx/dist/cli.mjs tools/cli/src/bin.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:test": "supabase test db",
    "db:reset": "supabase db reset",
    "db:seed": "node tools/cli/node_modules/tsx/dist/cli.mjs supabase/scripts/generate_seed.ts",
    "build:engine": "esbuild packages/case-engine/src/index.ts --bundle --format=esm --platform=neutral --outfile=supabase/functions/_shared/engine.js",
    "smoke:api": "node tools/cli/node_modules/tsx/dist/cli.mjs supabase/scripts/smoke.ts",
    "test:api": "vitest run --config supabase/vitest.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^20.17.6",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitest/coverage-v8": "^2.1.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.14.0",
    "hono": "^4.13.14",
    "prettier": "^3.3.3",
    "supabase": "^2.122.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/estree": "1.0.6"
    }
  },
  "workspaces": ["packages/*", "tools/*", "apps/*"]
}
