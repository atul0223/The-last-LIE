# THE LAST LIE: Infinite — Environment Variables Example
# Copy to .env.local for local overrides (never commit real secrets)

# Supabase Local/Hosted Settings
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Server & CLI only (Never expose to mobile/client bundles)
SUPABASE_SERVICE_ROLE_KEY=
# CLI case publisher endpoints (WP-42)
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_STAGING_URL=
SUPABASE_PROD_URL=

# API & Gateway Settings (WP-41)
# Comma-separated allowed CORS origins (defaults to *)
CORS_ORIGINS=
# HMAC secret key used by backend to sign and verify challenge guest tokens
GUEST_HMAC_SECRET=

# Runtime Environment
NODE_ENV=development

# Mobile Client Environment (WP-43)
# Game service provider: 'local' (offline prototype) | 'remote' (production/staging API) | 'fake'
EXPO_PUBLIC_GAME_SERVICE=local
# Base REST API endpoint for Hono edge function
EXPO_PUBLIC_API_URL=http://localhost:54321/functions/v1/api
# Supabase project URL & public anon key for mobile client
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Social authentication feature flags (WP-44)
EXPO_PUBLIC_ENABLE_APPLE_AUTH=false
EXPO_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Analytics & Monitoring (WP-46)
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
EXPO_PUBLIC_SENTRY_DSN=
