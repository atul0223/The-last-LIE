# THE LAST LIE: Infinite — Environment Variables Example
# Copy to .env.local for local overrides (never commit real secrets)

# Supabase Local/Hosted Settings
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-supabase-anon-key

# Server & CLI only (Never expose to mobile/client bundles)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Runtime Environment
NODE_ENV=development

# Analytics & Monitoring (WP-46)
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
EXPO_PUBLIC_SENTRY_DSN=
